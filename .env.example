# Environment Variables Example
# Copy this to .env for local development (never commit .env)
#
# KCE Campus AI needs NO AWS account, credentials, or paid AI API.
# The defaults below run the local knowledge base only.

# Local HTTP server (backend/server.py)
PORT=8000
HOST=localhost

# Optional: answer timeout used by the browser when API_ENDPOINT is configured
API_TIMEOUT_MS=6000
